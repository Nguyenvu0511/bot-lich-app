.RadScheduler_Sitefinity div.rsFooter
{
	background-color: #e5e7ea;
	background-repeat: repeat-x;
}

.RadScheduler_Sitefinity div.rsFooter a
{
	color: #000;
	background-color: transparent;
	background-repeat: no-repeat;
}

.RadScheduler_Sitefinity div.rsFooter a:hover
{
	color: #555;
}

/* </footer> */

