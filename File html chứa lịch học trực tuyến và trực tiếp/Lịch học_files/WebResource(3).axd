	border-color: #6187b8;
}

/* </appointments> */

/* <month view> */

.RadScheduler_Sitefinity .rsMonthView .rsDateBox
{
	background-color: #f1f1f1;
	border-bottom: 1px solid #ccc;
}

.RadScheduler_Sitefinity .rsMonthView .rsAptCreate .rsDateBox
{
	background-color: #e8e8e8;
	border-bottom: 1px solid #bbb;
}

.RadScheduler_Sitefinity .rsMonthView .rsContentTable td
{
	border-color: #ccc;
	border-style: solid;
}

/* </month view> */

/* <footer> */
.RadScheduler_Sitefinity div.rsFooter,
.RadScheduler_Sitefinity div.rsFooter a
{
	background-image: url('WebResource.axd?d=YuH6thg1x6SUamnegYA3azGpmukMRybocGA-oPZxRhCvwx_-9TyvooS_MOg8iSgD1N3yIaCEmqyHqr2uBJ5uiguCjn91V1qQXAfvqVVmJ_EAmXk_PwJOCSL0KRWvbWamxuG1FYM6RMqTJ8YfnlfmwXkMJZE1&t=634469285920000000');
