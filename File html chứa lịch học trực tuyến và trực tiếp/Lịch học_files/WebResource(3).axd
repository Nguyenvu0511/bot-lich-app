/* RadScheduler Office2007 skin */

/* common */
.RadScheduler_Sitefinity,
.RadScheduler_Sitefinity a,
.RadScheduler_Sitefinity input,
.RadScheduler_Sitefinity select,
.RadScheduler_Sitefinity textarea
{
	color: #333;
	font: normal 12px/14px Arial, Helvetica, sans-serif;
}

.RadScheduler_Sitefinity textarea
{
	background: #fff;
}

/* header */

/* header sprites */
.RadScheduler_Sitefinity .rsHeader ul a:hover,
.RadScheduler_Sitefinity .rsHeader ul a:hover span,
.RadScheduler_Sitefinity .rsHeader .rsSelected,
.RadScheduler_Sitefinity .rsHeader .rsSelected em,
.RadScheduler_Sitefinity .rsHeader .rsDatePickerActivator,
.RadScheduler_Sitefinity .rsHeader .rsPrevDay,
.RadScheduler_Sitefinity .rsHeader .rsNextDay
{
	background-image: url('WebResource.axd?d=YuH6thg1x6SUamnegYA3azGpmukMRybocGA-oPZxRhCvwx_-9TyvooS_MOg8iSgD1N3yIaCEmqyHqr2uBJ5uiguCjn91V1qQXAfvqVVmJ_EAmXk_PwJOCSL0KRWvbWamxuG1FYM6RMqTJ8YfnlfmwXkMJZE1&t=634469285920000000');
}

* html .RadScheduler_Sitefinity .rsHeader ul a:hover,
* html .RadScheduler_Sitefinity .rsHeader ul a:hover span,
* html .RadScheduler_Sitefinity .rsHeader .rsSelected,
* html .RadScheduler_Sitefinity .rsHeader .rsSelected em,
* html .RadScheduler_Sitefinity .rsHeader .rsDatePickerActivator,
* html .RadScheduler_Sitefinity .rsHeader .rsPrevDay,
* html .RadScheduler_Sitefinity .rsHeader .rsNextDay
{
	background-image: url('WebResource.axd?d=oFjGsOIW_OtiTIEKOK1YE9o8fu4T-JO8jhxh50-YHsT2PgLhMOni37jhUCE0h-HGqrO25XK6ExraIr0EH_AiPOJaVRcYlexCjjQ_nmdG_yjoZCKAHUXBWXnTjkSbAZBs9JlMmBoWztAOUm-O7cfQOFPc-AIxdBqRQVw0kQ2&t=634469285920000000');
}

.RadScheduler_Sitefinity div.rsHeader .rsPrevDay,
.RadScheduler_Sitefinity div.rsHeader .rsNextDay
{
	width: 19px;
	height: 20px;
}

.RadScheduler_Sitefinity div.rsHeader
{
	background-color: #e5e7ea;
	border: 1px solid #ccc;
}

.RadScheduler_Sitefinity .rsHeader
{
	color: #000;
}

.RadScheduler_Sitefinity .rsHeader a
{
	color: #000;
}

.RadScheduler_Sitefinity .rsHeader a:hover
{
	color: #555;
}

.RadScheduler_Sitefinity .rsHeader ul a:hover,
.RadScheduler_Sitefinity .rsHeader .rsSelected em
{
	color: #fff;
}

.RadScheduler_Sitefinity div.rsHeader .rsPrevDay
{
	margin: 6px 0 0 3px;
}

.RadScheduler_Sitefinity div.rsHeader .rsNextDay
{
	margin: 6px 6px 0 3px;
	background-position: -19px -48px;
}

.RadScheduler_Sitefinity div.rsHeader .rsNextDay:hover
{
	background-position: -89px -48px;
}

.RadScheduler_Sitefinity div.rsHeader ul
{
	padding-top: 4px;
}

.RadScheduler_Sitefinity div.rsHeader li,
.RadScheduler_Sitefinity .rsTopWrap div.rsHeader ul a
{
	line-height: 22px;
}

/* content */

.RadScheduler_Sitefinity .rsContent
{
	background: #fff;
}

/* <headers> */

.RadScheduler_Sitefinity .rsHorizontalHeaderTable
{
	color: #9c9c9c;
}

.RadScheduler_Sitefinity .rsHorizontalHeaderTable th span
{
	text-transform: uppercase;
	font-size: 10px;
	letter-spacing: 1px;
}

.RadScheduler_Sitefinity .rsHorizontalHeaderWrapper
{
	border-color: #ccc;
	background: #eee;
}

.RadScheduler_Sitefinity .rsSpacerCell,
.RadScheduler_Sitefinity .rsAllDayHeader,
.RadScheduler_Sitefinity .rsVerticalHeaderWrapper,
.RadScheduler_Sitefinity .rsVerticalHeaderTable
{
	background: #f1f1f1;
}

.RadScheduler_Sitefinity .rsVerticalHeaderTable th
{
	border-color: #f1f1f1;
	color: #000;
}

.RadScheduler_Sitefinity .rsHorizontalHeaderTable th
{
	border-color: #ccc;
	background-color: #FFF;
}

.RadScheduler_Sitefinity .rsVerticalHeaderTable th
{
	border-color: #f1f1f1 #ccc;
	border-top: 0;
}

.RadScheduler_Sitefinity .rsVerticalHeaderTable .rsAlt th
{
	border-color: #ccc #ccc;
}

/* </headers> */

/* <all-day-row> */

.RadScheduler_Sitefinity .rsAllDayRow
{
	background: #eee;
}

.RadScheduler_Sitefinity .rsSpacerCell,
.RadScheduler_Sitefinity .rsAllDayHeader,
.RadScheduler_Sitefinity .rsVerticalHeaderTable .rsAllDayHeader
{
	color: #000;
	border-color: #ccc;
}

.RadScheduler_Sitefinity .rsAllDayRow td,
.RadScheduler_Sitefinity .rsContentTable .rsAllDayRow td
{
	border-color: #ccc;
	border-style: solid;
}

.RadScheduler_Sitefinity .rsVerticalHeaderTable .rsMainHeader th
{
	border-bottom-color: #ccc;
}

.RadScheduler_Sitefinity .rsSpacerCell,
.RadScheduler_Sitefinity .rsContent .rsAllDayHeader
{
	border-bottom-color: #ccc;
}

/* </all-day-row> */

.RadScheduler_Sitefinity .rsContent,
.RadScheduler_Sitefinity .rsTopWrap .rsFooter
{
	border: 1px solid #ccc;
	border-top: 0;
}

.RadScheduler_Sitefinity .rsContentTable td
{
	border-color: #eee;
	border-bottom-style: dotted;
}

.RadScheduler_Sitefinity .rsContentTable .rsAlt td
{
	border-color: #ccc #eee;
	border-bottom-style: solid;
}

.RadScheduler_Sitefinity .rsMonthView .rsOtherMonth
{
	background-color: #F5F5F5;
}

/* <appointments> */
.RadScheduler_Sitefinity .rsApt .rsArrowTop,
.RadScheduler_Sitefinity .rsApt .rsArrowBottom,
.RadScheduler_Sitefinity .rsApt .rsArrowLeft,
.RadScheduler_Sitefinity .rsApt .rsArrowRight,
.RadScheduler_Sitefinity .rsApt .rsAptDelete,
.RadScheduler_Sitefinity .rsApt .rsAptDelete:hover,
.RadScheduler_Sitefinity .rsApt .rsAptResize,
.RadScheduler_Sitefinity .rsApt .rsAptRecurrence,
.RadScheduler_Sitefinity .rsApt .rsAptRecurrenceException
{
	background-color: transparent;
	background-image: url('WebResource.axd?d=YuH6thg1x6SUamnegYA3azGpmukMRybocGA-oPZxRhCvwx_-9TyvooS_MOg8iSgD1N3yIaCEmqyHqr2uBJ5uiguCjn91V1qQXAfvqVVmJ_EAmXk_PwJOCSL0KRWvbWamxuG1FYM6RMqTJ8YfnlfmwXkMJZE1&t=634469285920000000');
