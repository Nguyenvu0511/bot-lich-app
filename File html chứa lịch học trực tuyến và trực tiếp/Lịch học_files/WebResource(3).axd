.RadScheduler_Sitefinity .rsApt .rsAptDelete
{
	width: 22px;
}

.RadScheduler_Sitefinity .rsAptDelete:hover
{
	background-position: -61px -343px;
}

.RadScheduler_Sitefinity .rsAptCreate,
.RadScheduler_Sitefinity .rsMonthView .rsAptCreate,
.RadScheduler_Sitefinity .rsAptCreateRow2,
.RadScheduler_Sitefinity .rsMonthView .rsAptCreateRow2
{
	background-color: #e8e8e8;
}

.RadScheduler_Sitefinity .rsNonWorkHour,
.RadScheduler_Sitefinity .rsSunCol,
.RadScheduler_Sitefinity .rsSatCol
{
	background-color: #f8f8f8;
}

.RadScheduler_Sitefinity .rsAptCreateRow3,
.RadScheduler_Sitefinity .rsMonthView .rsAptCreateRow3,
.RadScheduler_Sitefinity .rsAptCreateRow4,
.RadScheduler_Sitefinity .rsMonthView .rsAptCreateRow4,
.RadScheduler_Sitefinity .rsAptCreateRow5,
.RadScheduler_Sitefinity .rsMonthView .rsAptCreateRow5
{
	background: #e8e8e8;
}

.RadScheduler_Sitefinity .rsAptContent,
.RadScheduler_Sitefinity .rsAptIn,
.RadScheduler_Sitefinity .rsAptMid,
.RadScheduler_Sitefinity .rsAptOut
