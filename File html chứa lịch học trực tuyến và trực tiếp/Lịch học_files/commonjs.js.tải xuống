//common
function checkstrinstr(input, str) {
    //alert(input + '--------' + str + '------' + input.indexOf(str));
    if (input.indexOf(str) != -1) return true;
    return false;
}

function removeid(input, rev, newstr) {
    //alert(input + '--------' + rev + '------' + newstr);
    return input.replace(rev, newstr);
}

function trimStart(input, symbol) {
    var dem = -1;
    for (var i = 0; i < input.length; i++) {
        if (input[0] != symbol) break;
        if (input[i] == symbol) {
            dem = i;
            if (input[i + 1] != symbol && i + 1 < input.length) {
                break;
            }
        }
    }
    if (dem >= 0)
        return input.substring(dem + 1, input.length);
    return input;
}
