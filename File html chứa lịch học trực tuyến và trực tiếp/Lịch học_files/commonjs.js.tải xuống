function checkItem(control, total, rowId, cheAllControl, cheItemControl, hidValueReturnControl, buttonEnableDisable) {
    var dem = 0;
    var i = 0;
    var idxOfRow = control.id.replace(cheItemControl, '');
    //alert(idxOfRow);    
    if (document.getElementById(control.id).checked) {
        for (i = 0; i < total; i++) {
            if (document.getElementById(cheItemControl + '' + i).checked) {
                dem++;
            }
        }
        //add class hightlight
        if (rowId != '') {
            $('#' + rowId + idxOfRow).removeClass('bgmouseout');
            $('#' + rowId + idxOfRow).addClass('bghighlight');
        }

        //alert(dem + '-' + total);
        if (dem == total) {
            document.getElementById(cheAllControl).checked = true;
        }
        if (!checkstrinstr(document.getElementById(hidValueReturnControl).value, '$' + document.getElementById(control.id).value + '$'))
            document.getElementById(hidValueReturnControl).value = document.getElementById(hidValueReturnControl).value + document.getElementById(control.id).value + '$';
    } else {
        for (i = 0; i < total; i++) {
            if (document.getElementById(cheItemControl + '' + i).checked) {
                dem++;
            }
        }
        //remove class hightlight
        if (rowId != '') {
            $('#' + rowId + idxOfRow).removeClass('bghighlight');
            $('#' + rowId + idxOfRow).addClass('bgmouseout');
        }
        document.getElementById(cheAllControl).checked = false;
        if (checkstrinstr(document.getElementById(hidValueReturnControl).value, '$' + document.getElementById(control.id).value + '$'))
            document.getElementById(hidValueReturnControl).value = removeid(document.getElementById(hidValueReturnControl).value, '$' + document.getElementById(control.id).value + '$', '$');
    }
    //alert(dem);
    //enable/disable button
    var btnSpl = buttonEnableDisable.split(',');
    var b = 0;
    if (dem > 0) {
        for (b = 0; b < btnSpl.length; b++) {
            if (btnSpl[b] != '')
                document.getElementById(btnSpl[b]).disabled = false;
        }
    } else {
        for (b = 0; b < btnSpl.length; b++) {
            if (btnSpl[b] != '')
                document.getElementById(btnSpl[b]).disabled = true;
        }
    }
    //alert(document.getElementById(hidValueReturnControl).value);
}

