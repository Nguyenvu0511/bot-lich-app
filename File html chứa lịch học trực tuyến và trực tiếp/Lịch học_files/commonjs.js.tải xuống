function setCheckedForCheckBox(total, rowId, cheAllControl, cheItemControl, listOfValue, buttonEnableDisable) {
    var btnSpl = buttonEnableDisable.split(',');
    var valueSpl = listOfValue.split('$');
    var dem = 0;
    for (var i = 0; i < total; i++) {
        for (var j = 0; j < valueSpl.length; j++) {
            if (valueSpl[j] != '') {
                if (document.getElementById(cheItemControl + '' + i).value == valueSpl[j]) {
                    document.getElementById(cheItemControl + '' + i).checked = true;
                    //add class hightlight
                    $('#' + rowId + i).removeClass('bgmouseout');
                    $('#' + rowId + i).addClass('bghighlight');
                    for (var b = 0; b < btnSpl.length; b++) {
                        if (btnSpl[b] != '')
                            document.getElementById(btnSpl[b]).disabled = false;
                    }
                    dem++;
                }
            }
        }
    }
    if (dem == total) {
        document.getElementById(cheAllControl).checked = true;
    }
}

