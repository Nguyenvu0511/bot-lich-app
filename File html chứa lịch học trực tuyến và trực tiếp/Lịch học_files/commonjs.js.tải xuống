function CreateToken(encryptData, key, iv) {
    var milliseconds = new Date().getTime();
    return encryptData + "." + EncryptString(milliseconds, key, iv);
}

function EncryptString(para, key, iv) {
    var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(para), CryptoJS.enc.Utf8.parse(key),
                             {
                                 keySize: 128,
                                 iv: CryptoJS.enc.Utf8.parse(iv),
                                 mode: CryptoJS.mode.CBC,
                                 padding: CryptoJS.pad.Pkcs7
                             });
    return encrypted;
}

function doClick(buttonId, e) {
    var key;
    if (window.event)
        key = window.event.keyCode;     //IE
    else
        key = e.which;     //firefox

    if (key == 13) {
        var btn = document.getElementById(buttonId);
        //alert(key);
        //alert(btn);
        if (btn != null) { //If we find the button click it
            btn.click();
            event.keyCode = 0;
        }
    }
}